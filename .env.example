# Copie para .env e preencha. Nao commitar o .env.
# Credenciais WABA de cada cliente ficam no banco (por tenant), nao aqui.

# Django
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Hardening de producao (HSTS, cookie seguro, redirect https). Opt-in.
SECURE_SSL=False
CSRF_TRUSTED_ORIGINS=

# Rota do admin (nao usar o /admin/ padrao em producao)
ADMIN_URL=painel/

# Banco
DATABASE_URL=postgres://whatsbot:whatsbot@localhost:5432/whatsbot_ia
DB_CONN_MAX_AGE=60

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# WhatsApp Cloud API (nivel do app Meta — por tenant fica no banco)
# App secret usado para validar a assinatura HMAC do webhook.
WHATSAPP_APP_SECRET=
# Token que voce define e informa a Meta na verificacao do webhook (GET).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Versao da Graph API.
WHATSAPP_API_VERSION=v21.0

# LLM (tier hibrido)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
